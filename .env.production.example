# Isi melalui Vercel Environment Variables, bukan commit credential.
APP_NAME=SIPERMINDA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=
# Alternatif DB_URL: isi seluruh field berikut sesuai provider.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=*
CACHE_STORE=database
QUEUE_CONNECTION=sync

OTP_DRIVER=whatsapp
OTP_EXPIRES_MINUTES=5
OTP_RETENTION_DAYS=7
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_OTP_TEMPLATE_NAME=siperminda_kode_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=id
# Template Meta terpisah dengan dua parameter body: nomor tiket dan status layanan.
WHATSAPP_STATUS_TEMPLATE_NAME=
WHATSAPP_STATUS_TEMPLATE_LANGUAGE=id
WHATSAPP_TIMEOUT_SECONDS=10
WHATSAPP_LOG_RETENTION_DAYS=30

FILESYSTEM_DISK=s3
DOCUMENTS_DISK=s3
DOCUMENTS_DIRECT_UPLOAD=true
PERMINTAAN_SLA_HARI_KERJA=2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Supabase Storage: isi region dan credential S3 dari pengaturan project.
AWS_DEFAULT_REGION=
AWS_BUCKET=
# Salin endpoint S3 lengkap, termasuk /storage/v1/s3. Jangan gunakan URL bucket publik.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

CRON_SECRET=
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SIPERMINDA

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
