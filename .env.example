APP_NAME=SIPERMINDA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

OTP_DRIVER=log
OTP_EXPIRES_MINUTES=5
OTP_RETENTION_DAYS=7
SMS_PROVIDER=verihubs
VERIHUBS_APP_ID=
VERIHUBS_API_KEY=
VERIHUBS_SANDBOX=false
VERIHUBS_OTP_TEMPLATE='Kode OTP SIPERMINDA: $OTP. Berlaku 5 menit. Jangan bagikan kode ini.'
VERIHUBS_OTP_CHALLENGE=autentikasi_pemohon
SMS_TIMEOUT_SECONDS=10

# Hanya untuk demo lokal/testing. DILARANG digunakan pada production BPS.
# Aktifkan sementara dengan APP_ENV=local dan OTP_DRIVER=fonnte.
FONNTE_TOKEN=
FONNTE_OTP_TEMPLATE='Kode OTP SIPERMINDA: $OTP. Berlaku 5 menit. Jangan bagikan kode ini.'
FONNTE_TIMEOUT_SECONDS=10

# Meta WhatsApp Cloud API. Aktifkan dengan OTP_DRIVER=whatsapp setelah konfigurasi lengkap.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_LOG_RETENTION_DAYS=30
WHATSAPP_OTP_TEMPLATE_NAME=siperminda_kode_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=id
# Template Meta terpisah dengan dua parameter body: nomor tiket dan status layanan.
WHATSAPP_STATUS_TEMPLATE_NAME=
WHATSAPP_STATUS_TEMPLATE_LANGUAGE=id
WHATSAPP_TIMEOUT_SECONDS=10

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENTS_DISK=local
DOCUMENTS_DIRECT_UPLOAD=true
PERMINTAAN_SLA_HARI_KERJA=2
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Isi region Supabase saat mengaktifkan DOCUMENTS_DISK=s3.
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Salin endpoint S3 Supabase lengkap, termasuk /storage/v1/s3.
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
